# ==========================================================
# Sentinel Chain — environment configuration
# Copy to .env and adjust. Never commit the real .env file.
# ==========================================================

APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (docker-compose service "postgres") ---
# When the backend runs on the host:  localhost
# When the backend runs in compose:   postgres
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinelchain

# --- Neo4j (docker-compose service "neo4j") ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=sentinelchain

# --- Ollama (local LLM) ---
# Ollama runs on the host machine. From inside a Docker container use
# http://host.docker.internal:11434 instead of localhost.
OLLAMA_BASE_URL=http://localhost:11434
# Any model pulled into Ollama (`ollama pull <model>`), e.g. llama3.1:8b, qwen2.5:7b, mistral
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=180
AI_MAX_FINDINGS_PER_ANALYSIS=5

# --- Background jobs ---
# Seconds without a heartbeat before an in-progress analysis/validation/remediation/ingestion
# is considered dead and marked FAILED (raised automatically to cover DOCKER_TIMEOUT and the LLM budget).
JOB_HEARTBEAT_TIMEOUT=900

# --- API access (optional) ---
# When set, every /api request except /api/health must send it as X-API-Key (or ?api_key=).
# Leave empty for a local single-user setup; the frontend reads VITE_API_KEY.
API_KEY=

# --- GitHub (optional; needed only for draft PR creation) ---
# Fine-grained or classic token with "repo" / contents+pull_requests write permission.
GITHUB_TOKEN=

# --- Workspace & sandbox ---
# Where clones, temporary working copies, sandbox logs and reports are stored.
REPOSITORY_WORKSPACE=./workspace
# Seconds before a sandbox container is killed.
DOCKER_TIMEOUT=600
DOCKER_PYTHON_IMAGE=python:3.12-slim
DOCKER_NODE_IMAGE=node:20-slim
