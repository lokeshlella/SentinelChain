{
  "name": "sentinel-fixture-monorepo",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "sentinel-fixture-monorepo",
      "version": "0.0.0",
      "workspaces": [
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "~5.4.0"
      }
    },
    "node_modules/@mono/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/@mono/lib": {
      "resolved": "packages/lib",
      "link": true
    },
    "node_modules/lodash": {
      "version": "4.17.21",
      "resolved": "https://registry.npmjs.org/lodash/-/lodash-4.17.21.tgz",
      "license": "MIT"
    },
    "node_modules/ms": {
      "version": "2.1.3",
      "resolved": "https://registry.npmjs.org/ms/-/ms-2.1.3.tgz",
      "license": "MIT"
    },
    "node_modules/typescript": {
      "version": "5.4.5",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.4.5.tgz",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/app": {
      "name": "@mono/app",
      "version": "1.0.0",
      "dependencies": {
        "@mono/lib": "workspace:*",
        "lodash": "^4.17.21",
        "ms": "^2.1.3"
      }
    },
    "packages/lib": {
      "name": "@mono/lib",
      "version": "1.0.0",
      "dependencies": {
        "ms": "2.0.0"
      },
      "peerDependencies": {
        "lodash": ">=4"
      }
    },
    "packages/lib/node_modules/ms": {
      "version": "2.0.0",
      "resolved": "https://registry.npmjs.org/ms/-/ms-2.0.0.tgz",
      "license": "MIT"
    }
  }
}
